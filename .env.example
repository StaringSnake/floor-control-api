# Local-only example for an isolated development Compose network. Never use these
# values in production; use managed credentials and TLS there.
POSTGRES_DB=floor_control_dev
POSTGRES_USER=floor_control_local
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=ecto://floor_control_local:local-development-only@db/floor_control_dev
SECRET_KEY_BASE=replace-with-a-long-random-value
PHX_HOST=localhost
PORT=4000
POOL_SIZE=10
DATABASE_SSL=false
# Production only (do not use with the local Compose database):
# DATABASE_SSL=true
# DATABASE_CA_CERT_FILE=/run/secrets/postgres-ca.crt
# DATABASE_SSL_SERVER_NAME=postgres.example.internal

# Required in production when DATABASE_SSL=true; provide these through the
# deployment secret/configuration mechanism rather than committing certificates.
# DATABASE_CA_CERT_FILE=/run/secrets/postgres-ca.pem
# DATABASE_SSL_SERVER_NAME=postgres.example.internal
